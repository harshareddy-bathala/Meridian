# An evaluation report's configuration, for
#
#   meridian report build --snapshot <raw snapshot> \
#       --config analysis/configs/evaluation.toml.example --seed 4471
#
# One table per section, each checked by the module that owns those settings.
# Every table and key is optional; the values below are the defaults. An
# unknown table or key is refused rather than ignored.
#
# The seed is NOT in this file. It is given with --seed, and every component's
# seed is derived from it by name (D-236); a `seed` here is refused.
#
# The run keeps this file byte for byte as config.toml, so `meridian report
# verify` rebuilds from exactly what was used. The configuration hash in the
# report's header is over the resolved values, so comments change nothing
# there — but the run's own hash covers config.toml's bytes (D-235).

# ── [labels] — how the raw snapshot is labelled, as `meridian snapshot label`
#    reads deploy/snapshot.toml.example. The same keys, one level down.
[labels]

# How long after a pass's window closes before a missing report is labelled as
# absence rather than excluded as `report_window_open`. A station holds unsent
# reports in a durable queue across an outage (D-146). 0 .. 2592000 (30 days).
settle_margin_s = 86400

# How far either side of a pass another reception of the same satellite still
# counts as evidence of whether it was transmitting (D-147). 1 .. 604800.
silent_window_s = 43200

# Contemporaneous attempts that heard nothing — our own `no_signal` with
# listening confirmed, or an archive's `no_data` — needed to call a satellite
# silent rather than indeterminate (D-147). 1 .. 100.
silent_min_attempts = 2

[labels.completeness]

# The completeness — attempted passes over eligible passes, per station-day — at
# or above which a station-day is kept for primary evaluation (D-151). 0 .. 1.
threshold = 0.8

# Thresholds every report also states retained and excluded station-days at, so
# a reader can judge the threshold rather than trust it (D-151). Rising, no
# repeats, each 0 .. 1.
sensitivity = [0.5, 0.6, 0.7, 0.8, 0.9]

# An archive station's computed pass counts as available only if it peaks at or
# above this elevation. Applied at labelling, so changing it needs no new
# export (D-150). 0 .. 90, degrees.
archive_min_elevation_deg = 0.0

# How far outside a computed window an archive reception may start and still be
# that pass — the station's clock and elements are not ours (D-150). 0 .. 3600.
archive_match_tolerance_s = 120

[labels.propensity]

# The fewest available passes a cell needs before its own attempted-over-
# available ratio is used; a sparser cell falls back to a coarser one — first
# dropping the hour band, then the satellite (D-152). 1 .. 10000.
min_cell = 20

# Edges between maximum-elevation bands, in degrees: [15, 30, 60] makes four
# bands, 0-15, 15-30, 30-60 and 60-90. Rising, each strictly between 0 and 90;
# an empty list is one band.
elevation_bands_deg = [15.0, 30.0, 60.0]

# Width of a local-solar-hour band. Must divide 24, so every band is equal.
hour_band_h = 4

# The least propensity a weight is computed from: a pass attempted with a
# lower propensity is weighted as if it had this one, so no weight exceeds its
# inverse — 20 at the default — and the report counts how many were floored
# (D-153). Greater than 0, at most 1.
floor = 0.05

# ── [prediction] — the model settings every configuration is fitted under, as
#    deploy/model.toml.example documents them, and the section's own. The report
#    fits A, C, D and D∖conditions itself and derives each one's seed, so
#    `configuration`, `seed` and `without` are refused here (D-236, D-237).
#    Needs the fit extra: uv sync --extra fit.
[prediction]

# Whose passes: "own", or "archive", which only configuration A can take; the
# others are then reported as not fitted, with the reason (D-156).
population = "own"

# Settled, usable outcomes a station needs before the configured model scores
# it; below that, the geometry-only model does (cold start, D-161).
min_station_history = 20

# The split dates (D-162). No default: without them no model is fitted, and
# every model's row says so. Set them for the snapshot being reported.
# train_until = 2027-01-01T00:00:00Z
# validate_until = 2027-02-01T00:00:00Z

inverse_regularisation = 1.0
weighting = "none"

# Rolling-origin folds refitted inside the span before validate_until.
folds = 4

# Station-day bootstrap draws behind every interval in the section. 100 .. 100000.
resamples = 2000

# A pass is disturbed when the Kp published before it is at least this: NOAA's
# G1 storm. 0 .. 9.
disturbed_kp = 5.0

# Disturbed test passes needed before the Kp feature is judged at all. Below
# it, the report says Kp is untested — never that it does not help
# (EVALUATION.md §3). Stated here, before any result is seen.
min_disturbed = 30

# ── [scheduling] — how every scheduler is replayed over the test span, as
#    deploy/schedule-evaluation.toml.example documents it. The report replays
#    the A, C and D models [prediction] fitted and derives the solver's seed,
#    so `models` and `seed` are refused here (D-238).
[scheduling]

# What a pass is worth besides its yield: "duration" or "none" (D-168).
frames = "duration"

# The solver's time limit per station-day, the same for every scheduler. A day
# the limit cuts short is counted in the report, since only then can a figure
# depend on the machine.
time_limit_s = 10.0

# Seconds an antenna needs between two passes.
turnaround_s = 0.0

# Paired bootstrap draws behind D − B, D − greedy B and the oracle regret.
resamples = 2000

# A completeness threshold in place of the dataset's own (D-151), to read the
# comparison at another. Leave unset to use the dataset's.
# threshold = 0.8

# ── [orbit] — the orbit-uncertainty section: timing error against element-set
#    age by regime, 1σ coverage (SC-3), and EVALUATION.md §6.3's spread test.
#    The bootstrap's seed is derived (D-236, D-239).
[orbit]

# Station-day bootstrap draws behind each regime's slope interval.
resamples = 2000

# Detections on element sets under a day old that §6.3's spread test needs.
# Below it, the test is reported as not run. Stated here, before any result.
min_young = 10

# ── [reliability] — the window and targets every indicator is judged against,
#    as deploy/reliability.toml.example's [slo] table holds them, and how far
#    apart the loss-budget history's windows end (D-184, D-240). Fault runs are
#    not configured here: give each with `report build --faults DIR`.
[reliability]

# SC-4 is a 30-day figure; another window is reported, and says so.
window_days = 30

# SC-4: ≥ 90% pass capture rate. Also sets the loss budget (D-185).
capture_rate_min = 0.90

# SC-5: ≤ 90 s to detect a failure, judged from the fault runs given.
failure_detection_max_s = 90

# Proposed targets, to agree with the team.
confirmed_miss_rate_max = 0.05
station_availability_min = 0.95
assignment_completion_rate_min = 0.95
schedule_execution_rate_min = 0.90
submission_delay_p95_max_s = 3600

# Days between the ends of the loss-budget history's windows.
history_step_days = 7
