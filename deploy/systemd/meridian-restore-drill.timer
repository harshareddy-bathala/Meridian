# Sundays, an hour after that night's backup. A failed drill is a failed unit:
# `systemctl --failed` and `journalctl -u meridian-restore-drill` show it.

[Unit]
Description=Weekly Meridian restore drill

[Timer]
OnCalendar=Sun *-*-* 03:47:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
