# Labelling settings for `meridian snapshot label --config <this file>`.
#
# Every key is optional; the values below are the defaults, taken from the
# decisions that introduced them. An unknown key is refused rather than ignored,
# so a misspelling cannot silently keep a default you believe you changed.
#
# The evaluation dataset's hash covers these *values*, not this file's bytes:
# comments and key order change nothing, and a file spelling out the defaults
# gives the same dataset as no file at all (D-144).

# How long after a pass's window closes before a missing report is labelled as
# absence rather than excluded as `report_window_open`. A station holds unsent
# reports in a durable queue across an outage (D-146). 0 .. 2592000 (30 days).
settle_margin_s = 86400

# How far either side of a pass another reception of the same satellite still
# counts as evidence of whether it was transmitting (D-147). 1 .. 604800.
silent_window_s = 43200

# Contemporaneous attempts that heard nothing — our own `no_signal` with
# listening confirmed, or an archive's `no_data` — needed to call a satellite
# silent rather than indeterminate (D-147). 1 .. 100.
silent_min_attempts = 2

[completeness]

# The completeness — attempted passes over eligible passes, per station-day — at
# or above which a station-day is kept for primary evaluation (D-151). 0 .. 1.
threshold = 0.8

# Thresholds every report also states retained and excluded station-days at, so
# a reader can judge the threshold rather than trust it (D-151). Rising, no
# repeats, each 0 .. 1.
sensitivity = [0.5, 0.6, 0.7, 0.8, 0.9]

# An archive station's computed pass counts as available only if it peaks at or
# above this elevation. Applied at labelling, so changing it needs no new
# export (D-150). 0 .. 90, degrees.
archive_min_elevation_deg = 0.0

# How far outside a computed window an archive reception may start and still be
# that pass — the station's clock and elements are not ours (D-150). 0 .. 3600.
archive_match_tolerance_s = 120

[propensity]

# The fewest available passes a cell needs before its own attempted-over-
# available ratio is used; a sparser cell falls back to a coarser one — first
# dropping the hour band, then the satellite (D-152). 1 .. 10000.
min_cell = 20

# Edges between maximum-elevation bands, in degrees: [15, 30, 60] makes four
# bands, 0-15, 15-30, 30-60 and 60-90. Rising, each strictly between 0 and 90;
# an empty list is one band.
elevation_bands_deg = [15.0, 30.0, 60.0]

# Width of a local-solar-hour band. Must divide 24, so every band is equal.
hour_band_h = 4

# The least propensity a weight is computed from: a pass attempted with a
# lower propensity is weighted as if it had this one, so no weight exceeds its
# inverse — 20 at the default — and the report counts how many were floored
# (D-153). Greater than 0, at most 1.
floor = 0.05
