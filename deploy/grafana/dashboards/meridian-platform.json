    {
      "type": "stat",
      "title": "Since last schedule",
      "description": "Seconds since the scheduling task last completed. Red past 900 s, where ScheduledTaskStalled fires.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "meridian-prometheus"
          },
          "expr": "time() - max(meridian_job_last_success_timestamp_seconds{task=\"schedule\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
