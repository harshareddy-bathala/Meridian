    {
      "type": "stat",
      "title": "Stations online — measured",
      "description": "Real stations whose last heartbeat is under 60 s old.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "meridian-prometheus"
          },
          "expr": "sum(meridian_stations{liveness=\"online\", simulated=\"false\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
