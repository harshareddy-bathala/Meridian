    {
      "type": "timeseries",
      "title": "Stations by liveness",
      "description": "Stale after 60 s without a heartbeat, offline after 90 s (D-054).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "meridian-prometheus"
          },
          "expr": "sum by (liveness, simulated) (meridian_stations)",
          "refId": "A",
          "legendFormat": "{{liveness}} · simulated={{simulated}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
