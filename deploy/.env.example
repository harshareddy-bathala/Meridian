# Meridian — example environment
#
#   cp deploy/.env.example .env && docker compose up
#
# Copy to .env at the repository root and edit. .env is gitignored; this file
# is not. Never put a real secret in here.
#
# Values below are development defaults. Every one of them must be changed
# before the platform is exposed publicly.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Platform ---------------------------------------------------------------
API_PORT=8000
API_LOG_LEVEL=info

# Signs station bearer tokens. Generate with:  openssl rand -hex 32
# A predictable value here means anyone can mint a station identity.
TOKEN_SECRET=change-me

# Invite token required by POST /msp/v0/register. See docs/DECISIONS.md D-006.
# Registration is not open in Phase 1.
REGISTRATION_INVITE_TOKEN=change-me

# Seconds between station heartbeats. Returned to stations at registration.
HEARTBEAT_INTERVAL_S=30

# --- Dashboard --------------------------------------------------------------
DASHBOARD_PORT=3000
PUBLIC_API_URL=http://localhost:8000

# --- Metrics ----------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me

# --- Simulator --------------------------------------------------------------
# Simulated stations are deterministic from this seed. Recording it is what
# makes a run reproducible — see docs/EVALUATION.md §9.
SIMULATOR_SEED=4471
SIMULATOR_STATION_COUNT=1
