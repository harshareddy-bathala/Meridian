# Meridian — example environment
#
#   cp deploy/.env.example .env && docker compose up
#
# Copy to .env at the repository root and edit. .env is gitignored; this file
# is not. Never put a real secret in here.
#
# Values below are development defaults. Every one of them must be changed
# before the platform is exposed publicly.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Platform ---------------------------------------------------------------
API_PORT=8000
API_LOG_LEVEL=info

# Peppers the hash of station bearer tokens. Generate with:  openssl rand -hex 32
# Tokens are opaque secrets stored hashed, not signed — see docs/DECISIONS.md
# D-017. The pepper defends the stored hashes against a read-only database leak.
# Rotating it invalidates every token. Each station then receives 401 and, per
# D-024, STOPS — it does not re-register, and it must not retry, because fifty
# stations retrying a dead token every 30s is a denial of service the network
# inflicts on itself. Recovery is per station and operator-driven: issue a bound
# replacement invite with `meridian invite create --for-station <id>`, which the
# station presents with its stored registration_key to rotate onto the same row
# (D-034). Budget for that before rotating.
TOKEN_HASH_PEPPER=change-me

# Seeds a single row in invite_tokens on an empty database, so a fresh
# `docker compose up` is immediately registerable. Further invites are issued
# with `meridian invite create`. See docs/DECISIONS.md D-006 and D-020.
# Registration is not open in Phase 1.
REGISTRATION_INVITE_TOKEN=change-me

# How long after registering a station may still recover a lost bearer token by
# re-presenting the same invite together with its stored registration_key
# (D-023). Recovery also requires that no heartbeat has arrived yet — both
# conditions, since by then the station demonstrably has a working token.
# A station past either one is recovered by an operator-issued invite bound to
# its station_id, which this window does not govern (D-034). Seconds.
REGISTRATION_RECOVERY_WINDOW_S=3600

# Seconds between station heartbeats. Returned to stations at registration.
HEARTBEAT_INTERVAL_S=30

# --- Dashboard --------------------------------------------------------------
DASHBOARD_PORT=3000

# --- Public exposure --------------------------------------------------------
# SC-6 is "a virtual station is visible on the public site from outside the
# college network", so localhost is only ever the development value.
#
# The platform refuses to start when TOKEN_HASH_PEPPER, REGISTRATION_INVITE_TOKEN
# or the password inside its database URL is still `change-me` and the deployment
# is public. Shipping `change-me` to a public address is the position D-006 exists
# to avoid, with an extra step.
#
# "Public" is any one of: a Cloudflare tunnel token being set (compose turns that
# into MERIDIAN_PUBLIC=1 for the api service), TUNNEL_HOSTNAME being set, or
# PUBLIC_BASE_URL naming anything but a loopback host. Three signals because the
# `public` profile happily starts a tunnel with the other two left at their
# development values.
PUBLIC_BASE_URL=http://localhost:8000

# Cloudflare Tunnel — outbound-only over 443, so no static IP, no inbound port
# and no firewall exception to request from college IT. Empty disables the
# tunnel service; it runs under the `public` compose profile. Setting it also
# puts the platform into public mode, so every secret above must be real first.
CLOUDFLARE_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=

# --- Metrics ----------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me

# --- Simulator --------------------------------------------------------------
# Simulated stations are deterministic from this seed. Recording it is what
# makes a run reproducible — see docs/EVALUATION.md §9.
SIMULATOR_SEED=4471
SIMULATOR_STATION_COUNT=1
