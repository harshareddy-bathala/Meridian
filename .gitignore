# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets — deploy/.env.example is tracked deliberately, see README quick start
.env
*.env
!deploy/.env.example

# The bearer token Prometheus presents to /metrics (D-087). Prometheus expands
# no environment variables in its own config, so this one secret has to exist as
# a file; the .example beside it is tracked and carries the placeholder.
deploy/prometheus/metrics_token

# A deployment's own Alertmanager configuration and the secrets it reads
# (D-112). Only the null-receiver default and the example are tracked.
deploy/alertmanager/*.local.yml
deploy/alertmanager/webhook_url
deploy/alertmanager/smtp_password

# Database backups (D-115). A dump holds every station's token hash and every
# invite, so it is a secret as much as it is data.
backups/
*.dump
*.dump.manifest.json
*.dump.partial

# Data. Nothing in the observation lineage belongs in git.
*.db
*.sqlite3
data/
products/
snapshots/

# The raw store (D-141). Retrieved artefacts are somebody else's bytes held
# unchanged, and the store is the one thing here that cannot be regenerated — it
# belongs in a backup, not in a repository. `data/` above already covers the
# default root; `ingest/raw/` is named as well because the roadmap sketch put it
# there and somebody will create it from the sketch.
ingest/raw/

# Recordings and capture folders (D-123, GIT-WORKFLOW.md Rule 4). A pass is about
# a gigabyte, and a recording of the sky is data, not source.
captures/
*.u8
*.cf32
*.iq

# Notebooks
.ipynb_checkpoints/

# Node / dashboard
node_modules/
dist/
build/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
.cursor/

# Scratch from site verification runs — browser profiles, HARs, Lighthouse
# JSON. Regenerable, and none of it is evidence of anything on its own.
.site-review/
CLAUDE.local.md
# Browser captures used as evidence while diagnosing a rendering bug. Kept
# locally; the reasoning they support is written down in docs/DECISIONS.md,
# which is the part that has to survive.
screenshots/
